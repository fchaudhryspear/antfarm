{
  "name": "antfarm",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "antfarm": "dist/cli/cli.js"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && npm run typecheck && cp package.json dist/package.json && cp src/server/index.html dist/server/index.html && chmod +x dist/cli/cli.js",
    "release:inject-version": "node scripts/inject-version.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\" scripts/__tests__/inject-version.test.js scripts/__tests__/package-manifest.test.js",
    "start": "npm run build && node dist/cli/cli.js"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "typescript": "^5.9.3"
  }
}
